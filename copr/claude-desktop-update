#!/usr/bin/env bash
#
# claude-desktop-update - keep the locally built Claude Desktop RPM current.
#
# Anthropic ships Claude Desktop as a .deb only, and the app is proprietary,
# so no repository can carry it. This command does the rebuild locally. It
# asks Anthropic's signed apt index which build is current (the build script
# verifies the signature), compares that against what is installed, and only
# downloads anything when the answer has changed.
#
# Run it by hand as root, or let claude-desktop-update.timer run it daily.
#
set -euo pipefail

BUILDER="/usr/libexec/claude-desktop-builder/build-official.sh"
STATE_DIR="/var/lib/claude-desktop-builder"
STATE_FILE="$STATE_DIR/last-build"
OUT_DIR="$STATE_DIR/out"
SCRATCH_DIR="/var/tmp"

CHECK_ONLY=0
FORCE=0

log()  { printf '%s\n' "$*"; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<EOF
Usage: claude-desktop-update [options]

  --check     Report whether a new build exists and do nothing else.
              Exit 0 when up to date, exit 2 when an update is available.
  --force     Rebuild and reinstall even when nothing changed upstream.
  -h, --help  Show this help.

With no options: rebuild and install only if upstream shipped a new build.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --check)   CHECK_ONLY=1; shift ;;
        --force)   FORCE=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *)         die "unknown option: $1 (try --help)" ;;
    esac
done

[ "$(id -u)" -eq 0 ] || die "must run as root (it installs an RPM)"
[ -x "$BUILDER" ] || die "missing build script: $BUILDER"

# rpmbuild wants a home directory; systemd does not always provide one.
export HOME="${HOME:-/root}"
# The unpacked payload is around 700 MB. The default scratch directory is
# often a memory filesystem, which is too small, so use /var/tmp instead.
export TMPDIR="${TMPDIR:-$SCRATCH_DIR}"

# ------------------------------------------------------------- upstream ------
# Index lookup only: the build script verifies the signed apt index and
# prints the newest entry. Nothing large is downloaded here.
latest="$("$BUILDER" --print-latest)" || die "could not read Anthropic's signed apt index"
read -r upstream_version upstream_sha256 upstream_file <<<"$latest"
[ -n "$upstream_sha256" ] || die "unexpected output from $BUILDER --print-latest: $latest"
# The .deb's SHA256 is the upstream build identity. RPM versions cannot
# contain '-', and the build script maps it to '.', so compare the same way.
upstream_id="$upstream_sha256"
upstream_version="${upstream_version//-/.}"

# --------------------------------------------------------------- local -------
if installed_version="$(rpm -q --qf '%{VERSION}' claude-desktop 2>/dev/null)"; then
    installed=1
else
    installed=0
    installed_version=""
fi

last_id=""
if [ -r "$STATE_FILE" ]; then
    last_id="$(head -1 "$STATE_FILE" 2>/dev/null || true)"
fi

# Up to date means: the installed version is the one upstream serves, and the
# last verified build recorded here is that exact upstream .deb. Anything else
# gets a verified rebuild, including the first run after upgrading from a
# builder that recorded no SHA256 (that one rebuild also adds files the older
# builder did not package) and a same-version upstream re-release.
up_to_date=0
if [ "$installed" -eq 1 ] && [ "$installed_version" = "$upstream_version" ] \
   && [ "$last_id" = "$upstream_id" ]; then
    up_to_date=1
fi
[ "$FORCE" -eq 1 ] && up_to_date=0

describe_upstream() {
    printf '%s (%s)' "$upstream_version" "$upstream_file"
}

if [ "$CHECK_ONLY" -eq 1 ]; then
    if [ "$up_to_date" -eq 1 ]; then
        log "up to date: claude-desktop $installed_version is the current upstream build"
        exit 0
    fi
    if [ "$installed" -eq 1 ] && [ "$installed_version" = "$upstream_version" ]; then
        log "rebuild due: $installed_version has no verified build record for upstream $(describe_upstream)"
    elif [ "$installed" -eq 1 ]; then
        log "update available: installed $installed_version, upstream $(describe_upstream)"
    else
        log "update available: claude-desktop is not installed, upstream $(describe_upstream)"
    fi
    exit 2
fi

if [ "$up_to_date" -eq 1 ]; then
    log "up to date: claude-desktop $installed_version is the current upstream build"
    exit 0
fi

# --------------------------------------------------------------- build -------
if [ "$installed" -eq 1 ] && [ "$installed_version" = "$upstream_version" ]; then
    log "verified rebuild of $installed_version from upstream $(describe_upstream)"
elif [ "$installed" -eq 1 ]; then
    log "upstream build changed: installed $installed_version, upstream $(describe_upstream)"
else
    log "claude-desktop is not installed; building upstream $(describe_upstream)"
fi

mkdir -p "$STATE_DIR"
rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR"

cleanup() { rm -rf "$OUT_DIR"; }
trap cleanup EXIT

log "building (this downloads around 165 MB and takes a few minutes)"
# Build exactly the entry checked above; if the index moved meanwhile the
# builder stops and the next run picks up the new one.
"$BUILDER" --outdir "$OUT_DIR" --expect-sha256 "$upstream_sha256" || die "build-official.sh failed"

rpm_file="$(find "$OUT_DIR" -maxdepth 1 -type f -name 'claude-desktop-*.rpm' -print -quit)"
[ -n "$rpm_file" ] || die "the build reported success but produced no RPM"

log "installing $(basename "$rpm_file")"
nevra="$(rpm -qp --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}' "$rpm_file")"
# The RPM was built a moment ago from a .deb whose SHA256 build-official.sh
# checked against Anthropic's signed apt index, so that signature is what
# vouches for it. The RPM itself is unsigned (unless rpmbuild autosigning is
# set up). Fedora 45 makes rpm refuse unsigned packages; dnf still installs a
# local file as long as localpkg_gpgcheck is off, which is the default. Turn
# it off for this one transaction in case the admin turned it on. Unlike
# --nogpgcheck, this leaves the signature check on for any dependencies dnf
# pulls in from repositories.
DNF_OPTS=(-y --setopt=localpkg_gpgcheck=0)
if rpm -q "$nevra" >/dev/null 2>&1; then
    # Same name, version and release already installed: dnf install would be
    # a no-op, so replace the files explicitly.
    dnf reinstall "${DNF_OPTS[@]}" "$rpm_file" || die "dnf could not reinstall $rpm_file"
else
    # Obsoletes in the built package means dnf replaces the old one in place.
    dnf install "${DNF_OPTS[@]}" "$rpm_file" || die "dnf could not install $rpm_file"
fi
rpm -q "$nevra" >/dev/null 2>&1 || die "$nevra is not installed after dnf finished"

printf '%s\n' "$upstream_id" > "$STATE_FILE.new" || die "could not write the build record $STATE_FILE.new"
mv -f "$STATE_FILE.new" "$STATE_FILE" || die "could not commit the build record $STATE_FILE"
new_version="$(rpm -q --qf '%{VERSION}' claude-desktop 2>/dev/null || echo unknown)"
log "claude-desktop $new_version installed"
